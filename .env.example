# Application
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
ADMIN_EMAILS=admin@example.com

# Paddle.js (client-side token is safe to expose)
# Use sandbox explicitly while testing. Sandbox tokens must start with test_.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace_with_your_sandbox_client_token

# Paddle server-side credentials. Never expose these through NEXT_PUBLIC_* variables.
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
# Permanent sandbox notification destination metadata.
PADDLE_NOTIFICATION_SETTING_ID=
PADDLE_WEBHOOK_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=openai/gpt-5-mini
OPENROUTER_TRANSLATION_MODEL=google/gemini-2.5-flash

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=LOAD <onboarding@resend.dev>
RESEND_TEST_RECIPIENT=
RESEND_ALLOW_GUEST_EMAIL=true
