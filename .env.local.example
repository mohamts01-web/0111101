# Supabase
## Private
SUPABASE_SERVICE_ROLE_KEY=

## Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated server-side administrator allowlist
ADMIN_EMAILS=admin@example.com

# Paddle
## Private
NEXT_PUBLIC_PADDLE_ENV=sandbox # or `production`
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

## Public
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# AI (OpenRouter) - server-only, never expose with NEXT_PUBLIC_
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=openai/gpt-5-mini
OPENROUTER_TRANSLATION_MODEL=google/gemini-2.5-flash
OPENROUTER_REQUIRE_ZDR=false

# Email (Resend) - server-only
RESEND_API_KEY=
RESEND_FROM_EMAIL=LOAD <onboarding@resend.dev>
RESEND_TEST_RECIPIENT=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
RESEND_ALLOW_GUEST_EMAIL=false
PADDLE_NOTIFICATION_SETTING_ID=
PADDLE_WEBHOOK_URL=
